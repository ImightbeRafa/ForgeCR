# Tilopay Payment Gateway
TILOPAY_BASE_URL=https://app.tilopay.com/api/v1
TILOPAY_API_KEY=
TILOPAY_USER=
TILOPAY_PASSWORD=
TILOPAY_WEBHOOK_SECRET=

# Order signing (HMAC for returnData) — falls back to TILOPAY_WEBHOOK_SECRET / TILOPAY_API_KEY
ORDER_SIGNING_SECRET=

# Resend Email
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=
RESEND_FROM_EMAIL=Forge Costa Rica <orders@forge.shopping>

# BetsyCRM
BETSY_API_KEY=
BETSY_API_URL=https://www.betsycrm.com/api/integration/orders/create

# Meta Pixel + Conversions API
# META_PIXEL_ID is optional (defaults to SITE.pixelId in shared/catalog.js)
META_PIXEL_ID=983130057569210
META_CAPI_ACCESS_TOKEN=

# Site
APP_URL=https://www.forge.shopping
SITE_URL=https://www.forge.shopping
WHATSAPP_NUMBER=50661043737
SINPE_PHONE=62019914
SINPE_HOLDER=Rafael Garcia

# Storefront (read at build time by the pages and at runtime by the API — same names)
# VITE_SOLD_OUT=arnes-4xl            # comma-separated size keys to mark sold out
# VITE_SOLD_OUT_MESSAGE=Agotado por ahora — escribinos por WhatsApp
# VITE_BUNDLE_2=1                    # 0 turns off the 2-pack price

# Local sandbox: npm run dev forces this to true; it is ignored on Vercel production.
# ORDER_DRY_RUN=true

# Unsafe switches — leave UNSET in production
# TILOPAY_REDIRECT_FULFILL=
# TILOPAY_ALLOW_UNSIGNED_WEBHOOKS=
