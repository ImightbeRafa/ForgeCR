{
  "name": "forge-costa-rica",
  "version": "2.0.0",
  "description": "ForgeCR — Arnés postural | Costa Rica",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "pages": "node scripts/build-pages.js",
    "dev": "node scripts/build-pages.js && vite",
    "build": "node scripts/build-pages.js && vite build",
    "preview": "vite preview",
    "images": "node scripts/optimize-images.js",
    "frames": "node scripts/prep-video-frames.mjs",
    "preview:design": "node scripts/build-preview.js",
    "test": "node --test \"tests/*.test.js\"",
    "start": "node server/prod.js",
    "start:sandbox": "node server/prod.js --sandbox"
  },
  "devDependencies": {
    "sharp": "^0.34.2",
    "terser": "^5.31.0",
    "vite": "^5.4.0"
  }
}
